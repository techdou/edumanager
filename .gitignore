# ============================================================
# EduManager .gitignore
# 原则：
#   1. 私密信息与密钥绝不入库（.env / 证书 / 密钥文件）
#   2. 运行时数据不入库（数据库 / 讲义内容 / 上传文件 / 备份）
#   3. 开发软件与 AI 编辑器配置目录不入库（.vscode / .idea / .claude 等）
#   4. 内部文档不入库（docs/ 存放设计文档与路线图，仅本地）
#   5. 构建产物与依赖不入库
# ============================================================

# ===== 密钥与环境变量（绝不提交）=====
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.pfx
*.p12
secrets.json
*.tfvars

# ===== 运行时数据（由程序生成/写入，含用户数据与付费内容）=====
data/
lectures/
server/uploads/
uploads/
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.backup*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# ===== 内部文档（仅本地，避免开发状态与内部设计泄漏）=====
docs/

# ===== 开发软件 / AI 编辑器配置目录 =====
.vscode/
.idea/
.claude/
.cursor/
.zcode/
.windsurf/
.trae/
.aider*
continue/
copilot*
*.code-workspace

# ===== 依赖 =====
node_modules/

# ===== 构建产物 =====
client/dist/
client/dist-backup*/
.next/
out/
build/
dist/
coverage/
.nyc_output/
.playwright-cli/
output/playwright/

# ===== 日志 =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 系统/编辑器临时文件 =====
.DS_Store
.DS_Store?
Thumbs.db
**/._*
desktop.ini
*.swp
*.swo

# ===== 杂项 =====
*.tsbuildinfo
coursework/
*.docx
tmp/

# ── 2026-10-27 统一范式补全（与 techdou 仓 .gitignore 标准对齐）──

# ── 私密信息与密钥：绝不入库 ──
secrets*
credentials*
*.token
_htpasswd


# ── 开发软件配置目录：本地工具状态不上传 ──
.claude.json
.codex/
.gemini/
.roo/
.aws/
.ssh/


# ── 内部文档与开发状态：不入版本控制，避免泄漏 ──
# README.md / CHANGELOG.md / SKILL.md / references/ / evals/ 是仓库正式内容，保持跟踪
drafts/
notes/
private/
internal/
dev/
dev-notes/
.archive/
.research/
*.draft.md
*.local.md
*.wip.md
DEVLOG.md
TODO.md
STATUS.md


# ── Python 运行产物 ──
__pycache__/
*.py[cod]
.venv/
venv/


# ── Node 前端产物 ──
.nuxt/


# ── 系统与临时文件 ──
*.tmp
*~
