# ===== 必填（生产环境缺失会拒绝启动）=====
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为至少48字节的随机十六进制字符串

# ===== 可选（带默认值）=====
NODE_ENV=development
PORT=3142

# CORS 白名单，逗号分隔。生产建议: https://edu.techdou.com
# 不设置则允许所有来源
# CORS_ORIGIN=https://edu.techdou.com,https://www.techdou.com

# 数据存储目录（默认为项目根的 data/ 和 lectures/）
# DATA_DIR=/var/lib/edumanager/data
# LECTURES_DIR=/var/lib/edumanager/lectures

# 上传临时目录（默认 <DATA_DIR>/uploads）
# UPLOADS_DIR=/var/lib/edumanager/data/uploads

# 离线全量备份目录（默认 <DATA_DIR>/backups）
# 手动备份必须先停服务；生产启动在监听前等待备份完成
# BACKUP_DIR=/var/backups/edumanager
# 保留备份数量，必须为正整数（默认 7）
BACKUP_RETENTION=7

# 生产访问请配置 HTTPS：私有内容使用 Secure HttpOnly Cookie
# 单个数据目录只允许一个服务或维护写进程

# 日志级别: error|warn|info|debug
LOG_LEVEL=info
