# ===== 必填（缺失或长度不足会拒绝启动，无兜底值）=====
# 生成方式: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请替换为至少48字节的随机十六进制字符串

# ===== 可选（带默认值）=====
NODE_ENV=development
PORT=3142

# 说明：npm run server:prod 与 server 用同一脚本，生产部署时把本文件的
# NODE_ENV 改为 production 即可（启动时自动备份、启用生产行为）

# CORS 白名单，逗号分隔。生产建议: https://edu.techdou.com
# 不设置则允许所有来源
# CORS_ORIGIN=https://edu.techdou.com,https://www.techdou.com

# 数据存储目录（默认为项目根的 data/ 和 lectures/）
# DATA_DIR=/var/lib/edumanager/data
# LECTURES_DIR=/var/lib/edumanager/lectures

# 日志级别: error|warn|info|debug
LOG_LEVEL=info
