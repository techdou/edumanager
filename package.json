{
  "name": "edumanager",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --env-file=.env server/index.js",
    "server:prod": "NODE_ENV=production node server/index.js",
    "client": "cd client && npm run dev",
    "verify": "node --env-file=.env scripts/verify_migration.js",
    "backup": "node --env-file=.env scripts/backup.js"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.11.1",
    "chardet": "^2.1.1",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  }
}
